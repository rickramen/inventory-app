<h1><%= isUpdate ? 'Update Trainer' : 'Create Trainer' %></h1>

<% if (error) { %>
  <p style="color:red"><%= error %></p>
<% } %>

<form method="POST" action="<%= isUpdate ? `/trainers/${trainer.id}/edit` : '/trainers/new' %>">
  <div>
    <label for="name">Trainer Name:</label>
    <input 
      type="text" 
      id="name" name="name" 
      value="<%= trainer ? trainer.name : '' %>" 
      required
    >
  </div>

  <button type="submit"><%= isUpdate ? 'Update Trainer' : 'Add Trainer' %></button>
</form>

<a href="/trainers">Back to list</a>