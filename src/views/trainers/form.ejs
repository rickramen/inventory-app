<%- include('../partials/header') %>

<h1>Add Trainer</h1>

<% if (error) { %>
  <p style="color:red"><%= error %></p>
<% } %>

<form action="/trainers/new" method="POST">
  <label>Name</label>
  <input
    type="text"
    name="name"
    value="<%= trainer ? trainer.name : '' %>"
    required
  >

  <button type="submit">Add Trainer</button>
</form>

<%- include('../partials/footer') %>