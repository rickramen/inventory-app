<%- include('../partials/header') %>

<% function capitalize(str) { return str.charAt(0).toUpperCase() + str.slice(1); } %>

<h1>Types</h1>
<ul>
  <% types.forEach(type => { %>
    <li>
      <a href="/types/<%= type.id %>"><%= capitalize(type.name) %></a>
    </li>
  <% }) %>
</ul>

<%- include('../partials/footer') %>