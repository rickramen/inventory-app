<%- include('../partials/header') %>

<div class="form-container">
  <h1><%= isUpdate ? 'Update Pokémon' : 'Create Pokémon' %></h1>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="POST" action="<%= isUpdate ? `/pokemon/${pokemon.id}/edit` : '/pokemon/new' %>">
    <div class="form-group">
      <label for="name">Pokémon Name:</label>
      <input type="text" id="name" name="name" 
             value="<%= pokemon ? pokemon.name : '' %>" 
             <%= isUpdate ? 'readonly' : '' %>>
    </div>

    <div class="form-group">
      <label for="trainer_id">Trainer:</label>
      <select id="trainer_id" name="trainer_id" required>
        <option value="" disabled selected>Assign New Trainer</option>
        <% trainers.forEach(trainer => { %>
          <option value="<%= trainer.id %>" 
                  <%= pokemon && trainer.id === pokemon.trainer_id ? 'selected' : '' %>>
            <%= trainer.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <button type="submit"><%= isUpdate ? 'Update Pokémon' : 'Add Pokémon' %></button>
  </form>

  <div class="back-link">
    <a href="/pokemon">⬅ Back to list</a>
  </div>
</div>

<%- include('../partials/footer') %>