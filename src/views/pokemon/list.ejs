<%- include("../partials/header") %>

<% function capitalize(str) { return str ? str.charAt(0).toUpperCase() + str.slice(1) : ''; } %>

<div class="list-header">
  <h2>All Pokémon</h2>
  <a href="/pokemon/new" class="button-link">Add Pokémon</a>
</div>

<% if (!pokemon || pokemon.length === 0) { %>
  <p>No Pokémon found.</p>
<% } else { %>
  <div class="card-grid">
    <% pokemon.forEach(p => { %>
      <div class="card">
        <% if (p.image_url) { %>
          <img src="<%= p.image_url %>" alt="<%= p.name %>">
        <% } %>
        <h3><a href="/pokemon/<%= p.id %>"><strong><%= capitalize(p.name) %></strong></a></h3>
        <p>Type: <%= capitalize(p.type) %></p>
        <p>Trainer: <%= capitalize(p.trainer) %></p>
        <div class="card-actions">
          <!-- Update button -->
          <form method="GET" action="/pokemon/<%= p.id %>/edit" style="display:inline;">
            <button type="submit">Update</button>
          </form>
          <!-- Delete button -->
          <form method="POST" action="/pokemon/<%= p.id %>/delete" style="display:inline;"
                onsubmit="return confirm('Are you sure you want to delete <%= capitalize(p.name) %>?');">
            <button type="submit">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include("../partials/footer") %>