<%- include("../partials/header") %>

<h2>All Pokémon</h2>

<table border="1" cellpadding="8" cellspacing="0">
  <thead>
    <tr>
      <th>Image</th>
      <th>Name</th>
      <th>Type</th>
      <th>Trainer</th>
    </tr>
  </thead>
  <tbody>
    <% if (!pokemon || pokemon.length === 0) { %>
      <tr>
        <td colspan="4">No Pokémon found.</td>
      </tr>
    <% } else { %>
      <% pokemon.forEach(p => { %>
        <tr>
          <td>
            <% if (p.image_url) { %>
              <img src="<%= p.image_url %>" width="50">
            <% } %>
          </td>
          <td>
            <a href="/pokemon/<%= p.id %>"><%= p.name %></a>
          </td>
          <td><%= p.type %></td>
          <td><%= p.trainer %></td>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>

<%- include("../partials/footer") %>